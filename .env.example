# BNB Chain address that receives the 0.5% platform fee on swaps.
# This is a public address, not a secret. Swaps stay disabled until it is set.
VITE_FEE_RECIPIENT=

# Optional. Integrator name registered at https://portal.li.fi with a fee wallet.
# Enables the 0.5% platform fee on Bitget (LI.FI) routes. Without it those routes charge no Qorbit fee.
VITE_LIFI_FEE_INTEGRATOR=
